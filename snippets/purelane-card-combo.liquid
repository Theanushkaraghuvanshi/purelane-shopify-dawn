{%- comment -%}
  Combo product card. Accepts: product
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  if variant == blank
    assign variant = product.variants.first
  endif
  assign components = product.metafields.custom.components.value
  assign flag = product.metafields.custom.flag
  assign save_label = product.metafields.custom.save_label
  assign highlight = product.metafields.custom.highlight.value
  assign compare = variant.compare_at_price
  if compare == blank or compare <= variant.price
    assign compare = 0
    if components
      for item in components
        assign compare = compare | plus: item.selected_or_first_available_variant.price
      endfor
    endif
  endif
  assign save_amount = 0
  if compare > variant.price
    assign save_amount = compare | minus: variant.price
  endif
  assign count = 0
  if components
    assign count = components.size
  endif
-%}
<article class="glass combo{% if highlight %} hero-combo{% endif %}">
  <div class="tray">
    {%- if save_label != blank -%}
      <span class="save">{{ save_label }}</span>
    {%- elsif save_amount > 0 -%}
      <span class="save">You save {% render 'purelane-money', amount: save_amount %}</span>
    {%- endif -%}
    {%- if flag != blank -%}
      <span class="flag">{{ flag }}</span>
    {%- endif -%}
    <div class="stack">
      {%- if components -%}
        {%- for item in components -%}
          {%- unless forloop.first -%}
            <span class="plus" aria-hidden="true">+</span>
          {%- endunless -%}
          <span class="it">
            {%- if item.featured_image -%}
              <img
                class="pimg"
                src="{{ item.featured_image | image_url: width: 240 }}"
                alt="{{ item.title | escape }}"
                width="80"
                height="120"
                loading="lazy"
              >
            {%- else -%}
              <span class="tile">{% render 'purelane-icon', icon: 'leaf' %}</span>
            {%- endif -%}
            <span>{{ item.metafields.custom.short_benefit | default: item.title }}</span>
          </span>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
  <div class="body">
    <h3>{{ product.title }}</h3>
    {%- if count > 0 -%}
      <div class="cnt">{{ count }} products</div>
    {%- endif -%}
    {%- if product.description != blank -%}
      <p class="inc">{{ product.description | strip_html }}</p>
    {%- endif -%}
    <div class="prow">
      {% render 'purelane-price', price: variant.price, compare_at: compare, save_style: 'amount' %}
    </div>
    <div class="fine">Inclusive of all taxes · COD available</div>
    {%- if variant -%}
      <button
        type="button"
        class="btn {% if highlight %}btn-primary{% else %}btn-ghost{% endif %}"
        data-pl-atc
        data-variant-id="{{ variant.id }}"
      >
        Shop bundle {% render 'purelane-icon', icon: 'arrow' %}
      </button>
    {%- else -%}
      <a class="btn btn-ghost" href="{{ product.url }}">View bundle {% render 'purelane-icon', icon: 'arrow' %}</a>
    {%- endif -%}
  </div>
</article>
