{%- comment -%}
  Accepts: title, quote, author, product_label, rating, duplicate (boolean)
{%- endcomment -%}
{%- liquid
  assign rating_n = rating | default: 5 | times: 1
  if rating_n < 1
    assign rating_n = 5
  endif
-%}
<article class="glass-2 rcard"{% if duplicate == true %} aria-hidden="true"{% endif %}>
  <div class="st" aria-label="{{ rating_n }} out of 5 stars">
    {%- for i in (1..5) -%}{%- if i <= rating_n -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
  </div>
  {%- if title != blank -%}
    <h3>{{ title }}</h3>
  {%- endif -%}
  {%- if quote != blank -%}
    <p>{{ quote }}</p>
  {%- endif -%}
  <div class="who">
    {% render 'purelane-icon', icon: 'check' %}
    <b>{{ author }}</b>
    {%- if product_label != blank -%}
      <span>· {{ product_label }}</span>
    {%- endif -%}
  </div>
</article>
