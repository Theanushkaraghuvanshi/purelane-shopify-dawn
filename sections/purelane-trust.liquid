<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      {%- for block in section.blocks -%}
        <div class="trust-i" {{ block.shopify_attributes }}>
          {% render 'purelane-icon', icon: block.settings.icon %}
          <span>{{ block.settings.label | newline_to_br }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane trust bar",
  "tag": "div",
  "class": "purelane-trust-section",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "leaf"
        },
        { "type": "textarea", "id": "label", "label": "Label", "default": "Plant derived\nformulas" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane trust bar" }]
}
{% endschema %}
