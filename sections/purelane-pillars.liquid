<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        <article class="glass pillar rv{% if forloop.index == 2 %} rv-d2{% elsif forloop.index == 3 %} rv-d3{% endif %}" {{ block.shopify_attributes }}>
          <span class="pi">{% render 'purelane-icon', icon: block.settings.icon %}</span>
          <h3 class="d3">{{ block.settings.title }}</h3>
          <p class="body-s">{{ block.settings.text }}</p>
          {%- if block.settings.cta_label != blank -%}
            <a class="btn btn-ghost btn-sm" href="{{ block.settings.cta_link | default: '#shop' }}">{{ block.settings.cta_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane pillars",
  "tag": "div",
  "class": "purelane-pillars-section",
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Bubbles" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "bubbles"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Less scrubbing" },
        { "type": "textarea", "id": "text", "label": "Body", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
        { "type": "text", "id": "cta_label", "label": "Button", "default": "Learn more" },
        { "type": "url", "id": "cta_link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane pillars" }]
}
{% endschema %}
