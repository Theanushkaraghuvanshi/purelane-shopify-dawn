<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:0 auto">{{ section.settings.lede }}</p>
      {%- endif -%}
      {%- form 'customer', class: 'pl-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,purelane-club">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          aria-label="Email address"
          autocomplete="email"
          required
        >
        <button class="btn btn-primary" type="submit">{{ section.settings.cta_label }}</button>
        {%- if form.posted_successfully? -%}
          <p class="lede" style="flex-basis:100%;margin:8px 0 0">You're in. Check your inbox for ₹100 off.</p>
        {%- elsif form.errors -%}
          <p class="lede" style="flex-basis:100%;margin:8px 0 0">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane signup",
  "tag": "div",
  "class": "purelane-signup-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    { "type": "text", "id": "lede", "label": "Body", "default": "Plus first access to new launches and restocks." },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "your@email.com" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get my ₹100 off" }
  ],
  "presets": [{ "name": "Purelane signup" }]
}
{% endschema %}
