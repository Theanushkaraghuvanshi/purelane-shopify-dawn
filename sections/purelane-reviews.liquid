<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.rating_label != blank -%}
        <span class="agg">
          <span class="st">★★★★★</span>
          <b>{{ section.settings.rating }}</b>
          {{ section.settings.rating_label }}
        </span>
      {%- endif -%}
      {%- if section.settings.loved_by != blank -%}
        <span class="agg">{{ section.settings.loved_by }}</span>
      {%- endif -%}
    </div>
  </div>
  {%- assign reviews = section.blocks | where: 'type', 'review' -%}
  {%- if reviews.size == 0 -%}
    <p class="pl-empty wrap">Add reviews in the theme editor, or connect a review metaobject list.</p>
  {%- else -%}
    <div class="revrail rv" aria-label="Customer reviews">
      <div class="revtrack">
        {%- for pass in (1..2) -%}
          {%- for block in reviews -%}
            {% render 'purelane-card-review',
              title: block.settings.title,
              quote: block.settings.quote,
              author: block.settings.author,
              product_label: block.settings.product_label,
              rating: block.settings.rating,
              duplicate: pass
            %}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Purelane reviews",
  "tag": "div",
  "class": "purelane-reviews-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Aggregate rating", "default": "4.8" },
    { "type": "text", "id": "rating_label", "label": "Rating caption", "default": "from 8,000+ reviews" },
    { "type": "text", "id": "loved_by", "label": "Social proof", "default": "Loved by 12 lakh+ homes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Author", "default": "Anita" },
        { "type": "text", "id": "product_label", "label": "Product", "default": "Laundry detergent" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "title": "Best dishwash ever", "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product_label": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "quote": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product_label": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "quote": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product_label": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "quote": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product_label": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
