<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.products != blank -%}
      <div class="comborail rv">
        {%- for product in section.settings.products -%}
          {% render 'purelane-card-combo', product: product %}
        {%- endfor -%}
      </div>
      {%- if section.settings.swipe_label != blank -%}
        <div class="swipecue" aria-hidden="true">
          {% render 'purelane-icon', icon: 'arrow' %}
          {{ section.settings.swipe_label }}
        </div>
      {%- endif -%}
      {%- if section.settings.footnote != blank -%}
        <p class="railnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="pl-empty">Select combo products. Each combo should list component products in the Components metafield.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "div",
  "class": "purelane-combos-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    { "type": "product_list", "id": "products", "label": "Combo products", "limit": 8 },
    { "type": "text", "id": "swipe_label", "label": "Swipe cue", "default": "Swipe for more combos" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Tapping \"Shop bundle\" adds the combo to your cart. You can still edit quantities before you pay."
    }
  ],
  "presets": [
    { "name": "Purelane combos" }
  ]
}
{% endschema %}
