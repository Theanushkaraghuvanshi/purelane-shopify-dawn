<section class="sec" id="range" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.lede }}</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          {%- for block in section.blocks -%}
            {% render 'purelane-pimg', art: block.settings.art, label: block.settings.label %}
          {%- endfor -%}
        </div>
      </div>
      {%- if section.settings.hint != blank -%}
        <p class="striphint">{{ section.settings.hint }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane range",
  "tag": "div",
  "class": "purelane-range-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    { "type": "textarea", "id": "lede", "label": "Body", "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink." },
    { "type": "text", "id": "hint", "label": "Swipe hint", "default": "Swipe to see the full shelf" }
  ],
  "blocks": [
    {
      "type": "bottle",
      "name": "Bottle",
      "settings": [
        {
          "type": "select",
          "id": "art",
          "label": "Bottle",
          "options": [
            { "value": "p-floor", "label": "Floor" },
            { "value": "p-tap", "label": "Tap" },
            { "value": "p-kitchen", "label": "Kitchen" },
            { "value": "p-toilet", "label": "Toilet" },
            { "value": "p-laundry", "label": "Laundry" },
            { "value": "p-dish", "label": "Dishwash" },
            { "value": "p-metal", "label": "Metal" },
            { "value": "p-wm", "label": "Washing machine" },
            { "value": "p-handwash", "label": "Handwash" },
            { "value": "p-eraser", "label": "Eraser" }
          ],
          "default": "p-kitchen"
        },
        { "type": "text", "id": "label", "label": "Alt text", "default": "Purelane product" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane range" }]
}
{% endschema %}
