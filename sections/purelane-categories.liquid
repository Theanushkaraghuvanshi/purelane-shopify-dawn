<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat rv{% if forloop.index > 1 %} rv-d{{ forloop.index | minus: 1 }}{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">{% render 'purelane-pimg', art: block.settings.art, label: block.settings.title %}</span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane categories",
  "tag": "div",
  "class": "purelane-categories-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "select",
          "id": "art",
          "label": "Bottle",
          "options": [
            { "value": "p-kitchen", "label": "Kitchen" },
            { "value": "p-toilet", "label": "Bathroom" },
            { "value": "p-laundry", "label": "Laundry" },
            { "value": "p-tap", "label": "Hard water" }
          ],
          "default": "p-kitchen"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "text", "label": "Caption", "default": "Grease, dishes & more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane categories" }]
}
{% endschema %}
