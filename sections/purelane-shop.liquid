<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
    </div>
    {%- if section.settings.products != blank -%}
      <div class="shelf">
        {%- for product in section.settings.products -%}
          {%- capture delay -%}rv-d{{ forloop.index | minus: 1 | modulo: 4 }}{%- endcapture -%}
          {% render 'purelane-card-product', product: product, delay_class: delay %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pl-empty">Choose products in the theme editor. Cards use live titles, prices, and inventory.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "div",
  "class": "purelane-shop-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 }
  ],
  "presets": [
    { "name": "Purelane shop" }
  ]
}
{% endschema %}
