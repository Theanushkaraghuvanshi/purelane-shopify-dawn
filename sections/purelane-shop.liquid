<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
    </div>
    {%- liquid
      assign picked = section.settings.products
      assign has_picked = false
      if picked != blank
        for product in picked
          if product.handle != blank
            assign has_picked = true
          endif
        endfor
      endif
    -%}
    <div class="shelf">
      {%- if has_picked -%}
        {%- for product in picked -%}
          {%- if product.handle != blank -%}
            {%- capture delay -%}rv-d{{ forloop.index | minus: 1 | modulo: 4 }}{%- endcapture -%}
            {% render 'purelane-card-product', product: product, delay_class: delay %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign handles = 'tap-cleaner-limescale-remover,kitchen-cleaner-foaming,copper-bronze-brass-cleaner,washing-machine-cleaner-descaler,dishwash-gel,fabric-conditioner,plant-based-concentrated-washing-machine-cleaner-and-hard-water-descaler-tablets-for-front-load-and-top-load-machines,magic-eraser' | split: ',' -%}
        {%- for handle in handles -%}
          {%- assign product = all_products[handle] -%}
          {%- if product.handle != blank -%}
            {%- capture delay -%}rv-d{{ forloop.index | minus: 1 | modulo: 4 }}{%- endcapture -%}
            {% render 'purelane-card-product', product: product, delay_class: delay %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if has_picked == false and all_products['tap-cleaner-limescale-remover'].handle == blank -%}
      <p class="pl-empty">Choose products in the theme editor. Cards use live titles, prices, and inventory.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane shop",
  "tag": "div",
  "class": "purelane-shop-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 }
  ],
  "presets": [
    { "name": "Purelane shop" }
  ]
}
{% endschema %}
