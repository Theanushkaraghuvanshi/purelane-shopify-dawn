<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      </div>
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">{% render 'purelane-icon', icon: block.settings.icon %}</span>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane why bundles",
  "tag": "div",
  "class": "purelane-why-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dollar", "label": "Save" },
            { "value": "check-box", "label": "Flat price" },
            { "value": "star-outline", "label": "Curated" },
            { "value": "truck", "label": "Shipping" }
          ],
          "default": "dollar"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "text", "label": "Caption", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane why bundles" }]
}
{% endschema %}
